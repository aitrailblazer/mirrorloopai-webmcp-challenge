    "stripe:mirrorloop:inventory": "python3 scripts/stripe-mirrorloop-inventory.py",
    "stripe:audit:analyze": "node scripts/stripe-audit-analyze.mjs --input testdata/stripe-audit/sanitized_sample.json --out artifacts/stripe-audit/sample/stripe_audit_analysis.json"
