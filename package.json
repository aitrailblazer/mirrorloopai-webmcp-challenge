    "eval:webmcp:agent": "node scripts/run-webmcp-agent-evals.mjs",
    "eval:webmcp:campaign": "WEBMCP_EVAL_CORPUS_PATH=web/evals/webmcp-campaign-evals.json WEBMCP_EVAL_EVIDENCE_ROOT=qa_evidence/webmcp_campaign_agent_eval WEBMCP_EVAL_LATEST_PATH=qa_evidence/webmcp_campaign_agent_eval/latest.json node scripts/run-webmcp-agent-evals.mjs",
    "eval:webmcp:operational-use-cases": "WEBMCP_EVAL_CORPUS_PATH=web/evals/webmcp-operational-use-cases.json WEBMCP_EVAL_EVIDENCE_ROOT=qa_evidence/webmcp_operational_use_case_eval WEBMCP_EVAL_LATEST_PATH=qa_evidence/webmcp_operational_use_case_eval/latest.json node scripts/run-webmcp-agent-evals.mjs",
    "report:webmcp:agent-evals": "node scripts/build-webmcp-agent-eval-report.mjs",
    "report:webmcp:campaign": "node scripts/build-webmcp-campaign-claim-audit.mjs",
    "report:webmcp:operational-use-cases": "node scripts/build-webmcp-operational-use-cases.mjs",
