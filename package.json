{
  "name": "mirrorloopai-static-site",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test web/tests/*.test.mjs",
    "test:webmcp:evals": "node scripts/validate-webmcp-evals.mjs",
    "test:webmcp:campaign-evals": "node scripts/validate-webmcp-campaign-evals.mjs",
    "test:webmcp:agent-evidence": "node scripts/validate-webmcp-agent-evidence.mjs",
    "test:webmcp:campaign-evidence": "node scripts/validate-webmcp-campaign-agent-evidence.mjs",
    "eval:webmcp:agent": "node scripts/run-webmcp-agent-evals.mjs",
    "eval:webmcp:campaign": "WEBMCP_EVAL_CORPUS_PATH=web/evals/webmcp-campaign-evals.json WEBMCP_EVAL_EVIDENCE_ROOT=qa_evidence/webmcp_campaign_agent_eval WEBMCP_EVAL_LATEST_PATH=qa_evidence/webmcp_campaign_agent_eval/latest.json node scripts/run-webmcp-agent-evals.mjs",
    "report:webmcp:agent-evals": "node scripts/build-webmcp-agent-eval-report.mjs",
    "report:webmcp:campaign": "node scripts/build-webmcp-campaign-claim-audit.mjs",
    "test:stripe": "node --test scripts/tests/*.test.mjs",
    "validate": "node scripts/validate-site.mjs",
    "validate:submission": "node scripts/validate-submission.mjs",
    "shop:images": "python3 scripts/build-shop-images.py",
    "stripe:account-import": "node scripts/stripe-account-import.mjs",
    "stripe:shop:provision": "python3 scripts/stripe-provision-shop.py",
    "stripe:webhook:provision": "python3 scripts/stripe-provision-webhook.py",
    "stripe:audit:collect": "node scripts/stripe-audit-collect.mjs",
    "stripe:mirrorloop:inventory": "python3 scripts/stripe-mirrorloop-inventory.py",
    "stripe:audit:analyze": "node scripts/stripe-audit-analyze.mjs --input testdata/stripe-audit/sanitized_sample.json --out artifacts/stripe-audit/sample/stripe_audit_analysis.json"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1"
  }
}
